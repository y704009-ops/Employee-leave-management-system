# ===================================================================
# ELMS / SkillMate — Environment Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# Backend Runtime & Profile
# -------------------------------------------------------------------
PORT=8080
# Profiles: 'demo' (in-memory H2, auto-seeded), 'dev' (local MySQL), or 'prod' (strict production)
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# Database Configuration (Development defaults shown)
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elms_db
DB_USER=root
DB_PASSWORD=root
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/elms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# -------------------------------------------------------------------
# CORS & URLs
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
BACKEND_URL=http://localhost:8080/api/v1
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------------
# JWT Configuration
# -------------------------------------------------------------------
# In development, a fallback key is available.
# In production, a secure 256-bit (>=32 bytes) key must be provided.
JWT_SECRET=super_secret_key_change_in_production_environment_12345
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# Frontend Configuration
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME="Employee Leave Management System"

# ===================================================================
# STRICT PRODUCTION REQUIREMENTS (SPRING_PROFILES_ACTIVE=prod)
# The following environment variables MUST be provided externally:
# - JWT_SECRET                (Minimum 32 bytes cryptographically secure key)
# - SPRING_DATASOURCE_USERNAME (Production database user)
# - SPRING_DATASOURCE_PASSWORD (Production database password)
# - DB_HOST or SPRING_DATASOURCE_URL (Production database host)
# - DB_NAME                   (Production database name)
# - CORS_ALLOWED_ORIGINS      (Production domain(s), e.g. https://app.example.com)
# ===================================================================
